{
  "name": "skybound",
  "productName": "SKYBOUND",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A 100-level 3D platformer built with Three.js",
  "author": "SKYBOUND",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node server.js",
    "icon": "node tools/make-icon.mjs",
    "portable": "electron-builder --win portable --x64"
  },
  "build": {
    "appId": "com.skybound.game",
    "productName": "SKYBOUND",
    "electronVersion": "33.4.11",
    "asar": true,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "index.html",
      "styles.css",
      "js/**/*",
      "vendor/**/*",
      "electron/**/*",
      "build/icon.ico",
      "build/icon.png",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "SKYBOUND-${version}-portable.exe"
    },
    "portable": {
      "requestExecutionLevel": "user",
      "useZip": true
    }
  },
  "devDependencies": {
    "electron-builder": "^26.0.12"
  }
}
